{
  "id": "kugou-lite",
  "name": "Kugou Lite",
  "version": "0.7.0",
  "minAppVersion": "0.1.24",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "gateway.kugou.com",
      "login-user.kugou.com",
      "login.user.kugou.com",
      "loginserviceretry.kugou.com",
      "userservice.kugou.com",
      "kugouvip.kugou.com",
      "openapi.kugou.com",
      "lyrics.kugou.com",
      "mlike.kugou.com"
    ]
  },
  "settings": [
    {
      "key": "signInMethod",
      "label": "Sign-in method",
      "type": "select",
      "help": "The QR code works for every account. The other two read the fields below",
      "options": [
        {
          "value": "",
          "label": "QR code (default)"
        },
        {
          "value": "sms",
          "label": "Phone + SMS code"
        },
        {
          "value": "password",
          "label": "Phone + password"
        }
      ]
    },
    {
      "key": "phone",
      "label": "Phone number",
      "help": "For signing in by SMS or by password"
    },
    {
      "key": "smsCode",
      "label": "SMS code",
      "help": "The code sent to your phone, to sign in with"
    },
    {
      "key": "password",
      "label": "Password",
      "type": "password",
      "help": "Only for Phone + password. It is kept as plain text in this plugin's data: delete it once you are signed in"
    },
    {
      "key": "claimVip",
      "label": "Claim the daily free VIP",
      "type": "boolean",
      "help": "The Concept app gives a day of VIP to whoever claims it. Without it, VIP songs play 60 seconds"
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "Private FM",
      "builtin": "stations"
    },
    {
      "title": "Charts",
      "page": "charts",
      "icon": "chart"
    },
    {
      "builtin": "liked"
    },
    {
      "title": "Saved Albums",
      "builtin": "savedAlbums"
    },
    {
      "title": "Recently Played",
      "page": "recent"
    }
  ]
}
